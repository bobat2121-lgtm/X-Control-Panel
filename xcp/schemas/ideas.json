                     "launch_post", "followups", "build_prompt", "series"],
        "properties": {
          "title": {"type": "string"},
          "hook": {"type": "string"},
          "format": {"type": "string", "enum": ["gif_sim", "short_video", "streamlit_page", "chart_pack", "calculator", "thread_series", "meme_template", "live_tracker"]},
          "pillar": {"type": "string", "enum": ["digital_credit", "bitcoin", "macro", "ai_models", "ai_benchmarks", "physical_ai"]},
          "why_now": {"type": "string"},
