# Streamlit Community Cloud -> your app -> Settings -> Secrets. Paste these (with real values).
# Master switch: the panel shows a "switched off" notice and connects to nothing unless this is "1".
XCP_LIVE = "1"
DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"
DISCORD_WEBHOOK_URL = "https://discord.com/api/webhooks/..."
# Lets panel buttons (rewrites, Run now) start the cloud agent immediately:
GH_DISPATCH_TOKEN = "github_pat_..."
GITHUB_REPO = "your-github-username/x-control-panel"
GITHUB_BRANCH = "main"
# Optional second lock on top of Streamlit's viewer allow-list:
PANEL_PASSWORD = ""
