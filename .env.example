# Copy to .env for local runs. In the cloud these go into GitHub Actions secrets
# (agent) and Streamlit secrets (panel). See README.md.

# Storage: blank = local SQLite (data/app.db). Cloud: your Postgres URL (Neon/Supabase).
DATABASE_URL=

# LLM: codex = your ChatGPT account via Codex CLI; mock = offline fake drafts for testing
LLM_BACKEND=codex
CODEX_MODEL=
CODEX_EXTRA_ARGS=
# Cloud only: encryption key for the stored Codex login (python -m jobs.run gen-key)
CODEX_AUTH_KEY=
CODEX_AUTH_FROM_DB=0

# X API (pay-per-use) app bearer token
X_BEARER_TOKEN=

# Discord alerts
DISCORD_WEBHOOK_URL=

# SEC asks for a contact in the User-Agent, e.g. "Your Name you@example.com"
SEC_USER_AGENT=

# Optional
FRED_API_KEY=
PANEL_URL=
PANEL_PASSWORD=

# Panel -> "run now" in the cloud (fine-grained PAT with Actions: read/write on the repo)
GH_DISPATCH_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main

# Local only: run queued panel work immediately in a background process
LOCAL_AGENT=1
